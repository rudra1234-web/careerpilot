# =====================================================================
# Reusable multi-stage build for every Spring Boot service.
# The VM only needs Docker — Maven runs inside the build stage, so you
# do NOT need a JDK or Maven installed on the host.
#
# Used from docker-compose.prod.yml as, e.g.:
#   build:
#     context: ../backend/user-service
#     dockerfile: ../../deploy/Dockerfile.service
# =====================================================================
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY pom.xml .
# Warm the dependency cache (best-effort; ignored if offline resolve is partial)
RUN mvn -q -e -B dependency:go-offline || true
COPY src ./src
RUN mvn -q -B clean package -DskipTests

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
# Timezone matters: services must run as Asia/Kolkata (see RUNBOOK issue #6)
ENV TZ=Asia/Kolkata
# Cap heap so five JVMs + Kafka + Keycloak + two DBs coexist comfortably.
ENV JAVA_OPTS="-Xms128m -Xmx384m -Duser.timezone=Asia/Kolkata"
COPY --from=build /src/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
