# =====================================================================
# Copy this file to `.env` and fill in the values, then run ./setup.sh
# =====================================================================

# Public hostname the app is served from (NO scheme, NO trailing slash).
# - Real domain:   careerpilot.example.com   (point an A record at the VM IP)
# - No domain?     Use the free wildcard-DNS trick with your VM's public IP:
#                  e.g. 129.153.10.20.sslip.io
#   sslip.io resolves <ip>.sslip.io to that IP, so Caddy can still issue a
#   valid HTTPS certificate automatically.
PUBLIC_HOST=YOUR_PUBLIC_IP.sslip.io

# Anthropic API key — required for AI question generation / resume parsing.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Change these from the defaults for a real deployment.
POSTGRES_PASSWORD=change-me-strong-pw
KEYCLOAK_ADMIN_PASSWORD=change-me-admin-pw
